# ---------- Supabase (required in production) ----------
# Project Settings -> API: Project URL and the public anon key. RLS protects every table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NOTE: the app never needs the service-role key. Do not add it here.

# Only for `npm run db:setup` (creates tables + loads content). Connect -> URI -> Session pooler.
DATABASE_URL=

# ---------- Sessions ----------
# Random string, at least 32 characters (signs child-mode / parent-unlock cookies).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EDUWORLD_SESSION_SECRET=

# ---------- AI tutor (currently switched off) ----------
# EduBuddy answers from the prepared knowledge base. The OpenAI tutor is disabled in code
# (src/lib/env.ts AI_TUTOR_ENABLED = false); these are only used if it is switched back on.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ---------- Development ----------
# Without Supabase variables the app uses a local JSON store in .data/ (development only).
# Set to true ONLY for a throwaway demo deployment without Supabase. Never for real users.
EDUWORLD_ALLOW_LOCAL_STORE=false
